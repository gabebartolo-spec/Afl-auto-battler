## The strip for a body's move from one side: {"x", "y", "size", "frames", "pivot", "reach"}.
static func strip(body: String, anim: String, facing: String) -> Dictionary:
	return BODIES[body]["anims"][anim][facing]


## Whether a body has a move from that side (small men don't play every move).
static func has(body: String, anim: String, facing: String) -> bool:
	return BODIES.has(body) and (BODIES[body]["anims"] as Dictionary).has(anim) \
			and (BODIES[body]["anims"][anim] as Dictionary).has(facing)


## Where frame i of a strip sits in the sheet.
static func source(s: Dictionary, i: int) -> Rect2:
	var f := clampi(i, 0, int(s["frames"]) - 1)
	var sz := frame_size(s)
	return Rect2(int(s["x"]) + f * sz.x, int(s["y"]), sz.x, sz.y)


## A strip's frame size, pixels.
static func frame_size(s: Dictionary) -> Vector2:
	return Vector2(s["size"][0], s["size"][1])


## Frame i's highest point above the feet, metres (a leap's hands).
static func reach(s: Dictionary, i: int) -> float:
	return float(s["reach"][clampi(i, 0, int(s["frames"]) - 1)])


# ---------------------------------------------------------------------------
# Hair overlays (docs/hair_production_plan.md in ard-asset-pipeline). The figures above
# are bald (a dark stubble cap, hair weight); each style's hair is its own atlas,
# assets/vignette/HAIR_FILES[i]: R lighting, A coverage, rendered with the body held out
# (where the body is in front, the hair is empty), so it's drawn straight after its
# figure, tinted like the figure's hair (hair_tones[hair] x R x 1.3), with the same
# transform and mirror. Each figure strip's "hair" has its cells per style id: they sit
# left to right from (x, y) in the atlas, each `size` pixels; `offset` is a cell's
# top-left in the figure strip's frame, pixels.
# ---------------------------------------------------------------------------

## The style id -> its atlas (HAIR_FILES, HAIR_TEXTURES). Generated: never edit by hand.
const HAIR_STYLE_INDEX := {
	"short_crop": 0,
	"bald": 1,
	"dreadlocks": 2,
	"swept_back": 3,
	"textured_short": 4,
}
const HAIR_FILES := ["hair_short_crop.png", "hair_bald.png", "hair_dreadlocks.png", "hair_swept_back.png", "hair_textured_short.png"]
const HAIR_TEXTURES := [preload("res://assets/vignette/hair_short_crop.png"), preload("res://assets/vignette/hair_bald.png"), preload("res://assets/vignette/hair_dreadlocks.png"), preload("res://assets/vignette/hair_swept_back.png"), preload("res://assets/vignette/hair_textured_short.png")]
const HAIR_BASE := "short_crop"
const HAIR_NONE := ["buzz"]
## Overlays drawn in the player's skin colour (skin tone x R x 1.3), not his hair colour.
const HAIR_TINT_SKIN := ["bald"]


## The hair a look's style draws over a figure strip (strip()): {"atlas", "x", "y", "size",
## "frames", "offset"}, or {} for none (HAIR_NONE). An id with no art for that move (or no
## art yet) draws the base look (short_crop).
static func hair_for(s: Dictionary, id: String) -> Dictionary:
	if id in HAIR_NONE:
		return {}
	var by: Dictionary = s.get("hair", {})
	return by.get(id, by.get(HAIR_BASE, {}))


## The atlas a hair strip's frames are in.
static func hair_texture(h: Dictionary) -> Texture2D:
	return HAIR_TEXTURES[int(h["atlas"])]


## Where frame i of a hair strip sits in its atlas.
static func hair_source(h: Dictionary, i: int) -> Rect2:
	var f := clampi(i, 0, int(h["frames"]) - 1)
	return Rect2(int(h["x"]) + f * int(h["size"][0]), int(h["y"]), h["size"][0], h["size"][1])


## A hair cell's top-left in the figure strip's frame, pixels: draw it at the figure's
## dest origin + offset x k, size x k.
static func hair_offset(h: Dictionary) -> Vector2:
	return Vector2(h["offset"][0], h["offset"][1])
